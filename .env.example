# Local FastAPI service used by the Vite client. VITE_API_BASE remains accepted
# for compatibility, but new environments should use VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8000

# Zoho Catalyst / QuickML (optional for offline local development)
CATALYST_ORG_ID=60079106947
QUICKML_RISK_URL=
QUICKML_RISK_KEY=
QUICKML_RAG_URL=
QUICKML_LLM_URL=
QUICKML_RAG_DOC_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional Zia speech-to-text gateway. If omitted, the microphone control
# explains that typed input should be used.
ZIA_STT_URL=
ZIA_STT_KEY=
